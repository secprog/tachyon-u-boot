stdin=serial,button-kbd
stdout=serial
stderr=serial
preboot=scsi scan
# fastboot_addr_r=0xA0000000
fastboot=fastboot -l $fastboot_addr_r usb 0
efi_bootmgr=bootefi bootmgr
# Windows-on-DisplayPort boot: DP now comes up autonomously at boot (the video
# uclass probes the DP device -> opens PMIC-GLINK, trains the link, lights the
# dock), and the EFI Graphics Output Protocol auto-registers against the live
# framebuffer when efi_bootmgr starts.  The DP driver has no .remove handler, so
# the link + framebuffer keep scanning out across ExitBootServices into Windows
# (no native Qualcomm DP/DPU driver).  No manual "tachyon dp start" command any
# more; win_boot is just the EFI boot manager.
win_boot=run efi_bootmgr
# usb_windows_setup=usb start; bootflow scan -bG usb0
# do_boot=run usb_windows_setup; run efi_bootmgr
# bootmenu_0=Boot USB Windows setup, then boot manager=run do_boot
bootmenu_0=Boot first available device=run efi_bootmgr
bootmenu_1=Boot Windows on DisplayPort dock=run win_boot
bootmenu_2=Enable fastboot mode=run fastboot
bootmenu_3=Reset device=reset
menucmd=bootmenu
# menucmd=tachyon resolution menu; bootmenu
# bootcmd=run do_boot  (disabled for diagnostic boot)
# DP comes up at boot regardless of boot_os now, so both paths just run the EFI
# boot manager.  (Verified: a live U-Boot DP only warns msm_dpu in Linux, works.)
bootcmd=run efi_bootmgr
