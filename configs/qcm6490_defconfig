# Configuration for building U-Boot to be flashed
# to the uefi partition of QCM6490 dev boards with
# the "Linux Embedded" partition layout (which have
# a dedicated "uefi" partition for edk2/U-Boot)

#include "qcom_defconfig"

CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_BASE=0x994000
CONFIG_DEBUG_UART_MSM_GENI=y
CONFIG_DEBUG_UART_CLOCK=7372800

# Address where U-Boot will be loaded
CONFIG_TEXT_BASE=0x9fc00000
CONFIG_REMAKE_ELF=y

# Enable capsule updates
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_CAPSULE_ON_DISK=y
CONFIG_EFI_IGNORE_OSINDICATIONS=y
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y

# ACPI support for Windows ARM64 boot
CONFIG_ACPI=y
CONFIG_ACPIGEN=y
CONFIG_GENERATE_ACPI_TABLE=y
CONFIG_EFI_ACPI_TABLES=y
CONFIG_GIC_V3_ITS=y

# PSCI is provided by TF-A at EL3 — U-Boot must NOT implement its own.
# The upstream DT (sc7280.dtsi) already declares psci { arm,psci-1.0; method = "smc"; }
# and all 8 CPU nodes have enable-method = "psci". PSCI_RESET (default y) handles
# system reset via SMC to TF-A independently of ARMV8_PSCI.
#
# CONFIG_ARMV8_PSCI is not set — would conflict with SEC_FIRMWARE_ARMV8_PSCI
# and would compile a redundant U-Boot PSCI that never runs (U-Boot is at EL2).
# Setting NR_CPUS=4 when SC7280 has 8 CPUs would also undersize per-CPU stacks.
# CONFIG_SEC_FIRMWARE_ARMV8_PSCI is not set — this framework loads a separate
# "secure firmware" FIT image (NXP SecMon model), not needed when TF-A provides PSCI.


# FIT Signature verification (dependency of EFI Secure Boot)
CONFIG_FIT_SIGNATURE=y

# Trusted Execution Environment (dependency of fTPM in OP-TEE)
CONFIG_TEE=y
CONFIG_OPTEE=y

# EFI Secure Boot (required for Windows 11)
# StandAloneMM in OP-TEE stores PK/KEK/db/dbx on RPMB (tamper-resistant).
# This replaces /ubootefi.var file storage and provides authenticated
# variable support required by EFI spec §32.3.6.
# Prerequisite: StandAloneMM TA must be loaded in OP-TEE by TF-A.
CONFIG_EFI_MM_COMM_TEE=y
CONFIG_EFI_SECURE_BOOT=y

# TPM 2.0 via OP-TEE fTPM (required for Windows 11)
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_FTPM_TEE=y
CONFIG_BLOBLIST_SIZE_RELOC=0x40000

# EFI TCG2 Protocol (measures boot to TPM, required for Windows 11)
CONFIG_EFI_TCG2_PROTOCOL=y

# RTC (required for EFI GetTime/SetTime runtime services)
CONFIG_DM_RTC=y
CONFIG_RTC_QCOM_PM8XXX=y
CONFIG_EFI_SET_TIME=y

# Runtime variable access is handled by StandAloneMM/OP-TEE backed storage.
# At ExitBootServices, runtime-accessible variables are collected from StMM
# and presented to the OS in DRAM. SetVariable at runtime returns
# EFI_UNSUPPORTED (OS must use authenticated boot-time paths per spec).
# CONFIG_EFI_RT_VOLATILE_STORE is incompatible with EFI_MM_COMM_TEE.
