# Configuration for building U-Boot to be flashed
# to the uefi partition of QCM6490 dev boards with
# the "Linux Embedded" partition layout (which have
# a dedicated "uefi" partition for edk2/U-Boot)

#include "qcm6490_defconfig"

CONFIG_SYS_VENDOR="particle"
CONFIG_SYS_BOARD="tachyon"
CONFIG_SYS_CONFIG_NAME="qcom"

CONFIG_DEFAULT_DEVICE_TREE="qcom/qcm6490-tachyon"

CONFIG_SYS_MALLOC_F=y
CONFIG_SYS_MALLOC_F_LEN=0x20000
CONFIG_MSM_SMEM=y
CONFIG_ARCH_FIXUP_FDT_MEMORY=y
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_DM_DEVICE_REMOVE=y

CONFIG_OF_SYSTEM_SETUP=y

CONFIG_DEFAULT_ENV_FILE="board/particle/tachyon/default.env"
CONFIG_OF_LIBFDT_OVERLAY=y

CONFIG_BOOTDELAY=-1

CONFIG_CMD_PMIC=y

# USB-C DisplayPort path: PMIC-GLINK boots ADSP on demand, queries
# Type-C orientation/Alt Mode policy, then the DP driver trains the link.
CONFIG_LOGLEVEL=4
CONFIG_LOG_MAX_LEVEL=9
CONFIG_LOG_DEFAULT_LEVEL=4
CONFIG_CMD_LOG=y
CONFIG_DM_MAILBOX=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_AOSS_QMP=y
# CONFIG_QCOM_ADSP_PAS is not set
# CONFIG_QCOM_PMIC_GLINK is not set
CONFIG_POWER_DOMAIN=y
CONFIG_QCOM_RPMH_POWER_DOMAIN=y
CONFIG_CLK_QCOM_SC7280_DISPCC=y
CONFIG_PINCTRL_QCOM_SC7280=y
# CONFIG_VIDEO_QCOM_TACHYON_DP is not set
CONFIG_QCOM_MDSS_BUS=y
CONFIG_PHY_QCOM_QMP_COMBO=y