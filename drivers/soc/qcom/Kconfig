#
# QCOM Soc drivers
#
menuconfig SOC_QCOM
	bool "Qualcomm SOC drivers support"
	help
	  Say Y here if you want to enable Qualcomm SOC drivers support.

if SOC_QCOM

config QCOM_COMMAND_DB
	bool "Qualcomm Command DB"
	help
	  Command DB queries shared memory by key string for shared system
	  resources. Platform drivers that require to set state of a shared
	  resource on a RPM-hardened platform must use this database to get
	  SoC specific identifier and information for the shared resources.

config QCOM_RPMH
	bool "Qualcomm RPMh support"
	depends on QCOM_COMMAND_DB
	help
	  Say y here to support the Qualcomm RPMh (resource peripheral manager)
	  if you need to control regulators on Qualcomm platforms, say y here.

config QCOM_ADSP_PAS
	bool "Qualcomm ADSP/CDSP PAS bootstrap"
	depends on ARM64 && OF_CONTROL && BLK && ARCH_SNAPDRAGON
	select ARM_SMCCC
	select CLK
	select CLK_STUB
	select EFI_PARTITION
	select FS_FAT
	select POWER_DOMAIN
	select QCOM_RPMH_POWER_DOMAIN
	help
	  Start Qualcomm ADSP/LPASS and CDSP remote processors through
	  the Peripheral Authentication Service using firmware stored in
	  the modem_a FAT partition.

if QCOM_ADSP_PAS

config QCOM_ADSP_PAS_STANDALONE
	bool "Boot ADSP standalone (bypass PMIC-GLINK)"
	default n
	help
	  Boot ADSP at driver probe time without waiting for PMIC-GLINK
	  to request it.  The diagnostic shutdown loop (600 ms poll +
	  SCM shutdown) is skipped; ADSP stays running after auth_and_reset.
	  Useful for isolating ADSP boot from the Type-C / DP-AltMode path.

endif

config QCOM_AOSS_QMP
	bool "Qualcomm AOSS QMP driver"
	depends on DM_MAILBOX && QCOM_IPCC && ARCH_SNAPDRAGON
	help
	  Enable support for the Qualcomm AOSS QMP (Qualcomm Messaging
	  Protocol) driver. This communicates with the Always-On Processor
	  (AOP) via shared memory (MSGRAM) and IPCC doorbell to toggle
	  remote processor load states and other AOP-managed resources.

config QCOM_PMIC_GLINK
	bool "Qualcomm PMIC GLINK transport"
	depends on MSM_SMEM && ARM64 && OF_CONTROL && BLK
	select QCOM_ADSP_PAS
	select DM_MAILBOX
	select QCOM_IPCC
	help
	  Enable a small Qualcomm PMIC-GLINK transport over the LPASS/ADSP
	  GLINK-SMEM edge. This is used during early boot to query USB-C
	  DisplayPort Alt Mode policy before initializing the display path.

endif # SOC_QCOM
